<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NovaLauncher.App/NovaLauncher.App.csproj" />
    <ProjectReference Include="../NovaLauncher.LaunchProbe/NovaLauncher.LaunchProbe.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
