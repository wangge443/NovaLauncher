<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:NovaLauncher.App.Helpers"
                    xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <sys:Double x:Key="SectionTitleSize">16</sys:Double>
    <sys:Double x:Key="ApplicationNameSize">13</sys:Double>
    <sys:Double x:Key="SecondaryTextSize">12</sys:Double>
    <sys:Double x:Key="StatisticsTextSize">10.5</sys:Double>
    <sys:Double x:Key="NavigationTextSize">14</sys:Double>
    <sys:Double x:Key="NavigationIconSize">18</sys:Double>
    <sys:Double x:Key="NavigationRowHeight">44</sys:Double>
    <GridLength x:Key="NavigationIconSlot">30</GridLength>
    <Thickness x:Key="NavigationPadding">18,0,12,0</Thickness>
    <Thickness x:Key="NavigationLabelMargin">10,0,0,0</Thickness>
    <Thickness x:Key="NavigationGroupSpacing">0,0,0,12</Thickness>
    <sys:Double x:Key="EmptyIconSize">32</sys:Double>
    <sys:Double x:Key="EmptyTitleSize">20</sys:Double>
    <Thickness x:Key="EmptyIconSpacing">0,0,0,20</Thickness>
    <Thickness x:Key="EmptyHintSpacing">0,8,0,0</Thickness>
    <Thickness x:Key="ApplicationNameSpacing">0,8,0,0</Thickness>
    <sys:Double x:Key="ActionTextSize">12</sys:Double>
    <sys:Double x:Key="ApplicationCardWidth">136</sys:Double>
    <sys:Double x:Key="ApplicationCardHeight">136</sys:Double>
    <sys:Double x:Key="ApplicationIconSize">64</sys:Double>
    <sys:Double x:Key="ApplicationNameLineHeight">19</sys:Double>
    <sys:Double x:Key="ApplicationNameHeight">38</sys:Double>
    <sys:Double x:Key="ApplicationDetailsIconSize">32</sys:Double>
    <Thickness x:Key="ApplicationDetailsPadding">8,12,8,8</Thickness>
    <Thickness x:Key="ApplicationStatisticsMargin">0,4,0,0</Thickness>
    <Duration x:Key="LaunchFeedbackDuration">0:0:0.13</Duration>
    <sys:Double x:Key="ApplicationCardLift">1</sys:Double>
    <Thickness x:Key="ApplicationCardMargin">4</Thickness>
    <Thickness x:Key="ApplicationCardPadding">12,12,12,8</Thickness>
    <CornerRadius x:Key="ApplicationCardRadius">12</CornerRadius>
    <!-- Native backdrop and opaque fallback use separate white surface overlays. -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F9FAFC" />
    <SolidColorBrush x:Key="BackgroundFallbackBrush" Color="#F9FAFC" />
    <SolidColorBrush x:Key="GlassTintBrush" Color="#A6FFFFFF" />
    <!-- Keep the experimental system material light even when DWM renders a gray surface. -->
    <SolidColorBrush x:Key="NativeGlassTintBrush" Color="#D9FFFFFF" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#A8FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#18344058" />
    <SolidColorBrush x:Key="TextBrush" Color="#283446" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#657083" />
    <SolidColorBrush x:Key="EmptyTextBrush" Color="#586579" />
    <SolidColorBrush x:Key="EmptyIconBrush" Color="#8A96A7" />
    <SolidColorBrush x:Key="AccentBrush" Color="#526BB5" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#14617FC2" />
    <SolidColorBrush x:Key="HoverBrush" Color="#0F324F88" />
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#32D93B48" />
    <Duration x:Key="HoverDuration">0:0:0.16</Duration>
    <sys:Double x:Key="SearchHeight">40</sys:Double><sys:Double x:Key="SearchWidth">320</sys:Double><CornerRadius x:Key="SearchRadius">8</CornerRadius>
    <CornerRadius x:Key="SurfaceRadius">16</CornerRadius>
    <Thickness x:Key="WorkspacePadding">24</Thickness>
    <Thickness x:Key="ToastPadding">16,10</Thickness>
    <sys:Double x:Key="ToastMaxWidth">320</sys:Double>
    <FontFamily x:Key="AppFont">Microsoft YaHei UI, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Retain native ScrollBar/Track behavior, including drag, page commands and automation. -->
    <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarWidthKey}">12</sys:Double>
    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Background="Transparent">
                        <Border x:Name="Grip" Width="4" Margin="0,2" CornerRadius="3" Background="{DynamicResource MutedTextBrush}" Opacity="0.4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="True">
                            <Setter TargetName="Grip" Property="Width" Value="6" />
                            <Setter TargetName="Grip" Property="Opacity" Value="0.75" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1" /></Trigger>
                        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True"><Setter TargetName="Grip" Property="Opacity" Value="1" /></DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPageButton}" /></Track.DecreaseRepeatButton>
                                    <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}" /></Track.Thumb>
                                    <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPageButton}" /></Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style x:Key="FocusRing" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2"
                            CornerRadius="8" Margin="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="GlassWorkspaceSurface" Color="White"/>
    <SolidColorBrush x:Key="AppearanceLabelSurface" Color="#CCFFFFFF"/>
    <SolidColorBrush x:Key="ApplicationNameSurface" Color="#CCFFFFFF"/>
    <Style x:Key="ApplicationNameStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource ApplicationNameSize}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="LineHeight" Value="{StaticResource ApplicationNameLineHeight}" />
        <Setter Property="Height" Value="{StaticResource ApplicationNameHeight}" />
        <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.NeedsTextSurface, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
            <Setter Property="Background" Value="{DynamicResource ApplicationNameSurface}"/>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="ApplicationDetailStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FontSize" Value="{StaticResource StatisticsTextSize}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Height" Value="15" />
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{StaticResource ActionTextSize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border helpers:HoverFeedback.IsEnabled="True" x:Name="Hover" Background="{TemplateBinding Background}" Opacity="0" CornerRadius="6" Margin="2" />
                        <TextBlock Text="{TemplateBinding Content}" FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}"
                                   IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NavigationItemStyle" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource NavigationRowHeight}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Selection" CornerRadius="8" Background="{DynamicResource SelectedBrush}" Opacity="0" />
                        <Border helpers:HoverFeedback.IsEnabled="True" x:Name="Hover" CornerRadius="8" Background="{DynamicResource HoverBrush}" Opacity="0" />
                        <Border IsHitTestVisible="False" x:Name="Indicator" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        <ContentPresenter IsHitTestVisible="False" Margin="{StaticResource NavigationPadding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selection" Property="Opacity" Value="1" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Selection" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Selection" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Selection" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSettings}" Value="True">
                <Setter Property="Margin" Value="0,16,0,2" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SidebarActionButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="{StaticResource NavigationRowHeight}" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="Padding" Value="{StaticResource NavigationPadding}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource NavigationTextSize}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border helpers:HoverFeedback.IsEnabled="True" Background="{DynamicResource HoverBrush}"
                                CornerRadius="8" Opacity="0" />
                        <Border x:Name="PressedSurface" Background="{DynamicResource SelectedBrush}"
                                CornerRadius="8" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="Label" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                          IsHitTestVisible="False" Opacity="0.97" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Label" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            <Setter TargetName="Label" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PressedSurface" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Label" Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SidebarSplitterStyle" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Width="1" HorizontalAlignment="Right"
                                Background="{DynamicResource BorderBrush}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Line" Property="Width" Value="2" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Line" Property="Width" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
    <Style x:Key="FavoriteButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="Transparent" CornerRadius="6">
                        <TextBlock x:Name="Star" Text="{Binding FavoriteGlyph}" FontFamily="{StaticResource IconFont}"
                                   FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" Opacity="0.45" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Star" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter TargetName="Star" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Star" Property="Opacity" Value="1" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Star" Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <sys:Double x:Key="CategoryPopupWidth">224</sys:Double>
    <Style x:Key="QuietButton" TargetType="primitives:ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource ActionTextSize}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="primitives:ButtonBase">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CardCategoryButton" TargetType="ToggleButton" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="ContentTemplate">
            <Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontFamily="{StaticResource IconFont}" FontSize="12"
                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /></DataTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="CategoryChoiceStyle" TargetType="ListBoxItem" BasedOn="{StaticResource NavigationItemStyle}">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Thickness x:Key="WorkspaceHeadingSpacing">4,0,4,18</Thickness>
    <Style x:Key="WorkspaceSectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
        <Setter Property="FontSize" Value="{StaticResource SectionTitleSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.NeedsTextSurface, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
            <Setter Property="Background" Value="{DynamicResource AppearanceLabelSurface}"/>
        </DataTrigger><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Padding" Value="0,3"/><Setter Property="FontSize" Value="22"/><Setter Property="Background" Value="Transparent"/></DataTrigger></Style.Triggers>
    </Style>
    <sys:Double x:Key="ProfileSmallAvatarSize">34</sys:Double>
    <sys:Double x:Key="ProfileLargeAvatarSize">72</sys:Double>
    <sys:Double x:Key="ProfileFlyoutWidth">264</sys:Double>
    <Style x:Key="ProfileActionButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="ProfileAvatarButton" TargetType="Button">
        <Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="24">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                <DataTrigger Binding="{Binding IsProfileFlyoutOpen}" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /></DataTrigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource WorkspaceSectionTitle}">
        <Setter Property="Margin" Value="0,20,0,10"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="15"/><Setter Property="Margin" Value="0,24,0,12"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsRow" TargetType="Border">
        <Setter Property="Padding" Value="16,12"/><Setter Property="MinHeight" Value="64"/>
        <Setter Property="Margin" Value="0,0,0,4"/><Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}"/>
    <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource GlassCardSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassSurfaceBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="Effect" Value="{DynamicResource GlassCardShadow}"/><Setter Property="TextElement.FontSize" Value="14"/></DataTrigger></Style.Triggers></Style>
    <Style x:Key="SettingsDescription" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource SecondaryTextSize}"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,4,0,0"/>
    </Style>
    <Style x:Key="SettingsButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="CategoryCreateRow" TargetType="Button" BasedOn="{StaticResource SettingsButton}">
        <Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Margin" Value="0,8,0,0"/>
        <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
            <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="42"/><Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="{DynamicResource GlassCategorySurface}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource GlassSurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="8,2">
                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassInputHoverSurface}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassInputActiveSurface}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="SettingsToggle" TargetType="CheckBox">
        <Setter Property="Width" Value="48"/><Setter Property="Height" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
                <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="{DynamicResource MutedTextBrush}">
                    <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" Fill="{DynamicResource WindowBrush}"/>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.65"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SettingsSelector" TargetType="ComboBox">
        <Setter Property="MinWidth" Value="116"/><Setter Property="MinHeight" Value="32"/>
        <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="4"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style></Setter.Value></Setter>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
            <Grid>
                <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                    <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{DynamicResource WindowBrush}" Padding="12,6">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></ToggleButton.Template>
                </ToggleButton>
                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                    <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="AppearanceSlider" TargetType="Slider">
        <Setter Property="Height" Value="32"/><Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Margin="8,0">
                <Border Height="4" CornerRadius="2" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>
                <Track x:Name="PART_Track">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" Style="{StaticResource ScrollPageButton}"/></Track.DecreaseRepeatButton>
                    <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="{DynamicResource AccentBrush}" Stroke="{DynamicResource WindowBrush}" StrokeThickness="3"/>
                    </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" Style="{StaticResource ScrollPageButton}"/></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <sys:Double x:Key="QuickLauncherWidth">580</sys:Double>
    <sys:Double x:Key="QuickRowHeight">64</sys:Double>
    <sys:Double x:Key="QuickIconSize">40</sys:Double>
    <SolidColorBrush x:Key="QuickScrimBrush" Color="#18304060"/>
    <Style x:Key="QuickSearchTrigger" TargetType="Button" BasedOn="{StaticResource QuietButton}">
        <Setter Property="Width" Value="{StaticResource SearchWidth}"/>
        <Setter Property="Height" Value="{StaticResource SearchHeight}"/>
        <Setter Property="Margin" Value="0,0,0,24"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
        <Setter Property="Background" Value="{DynamicResource WindowBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="{StaticResource SearchRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassInputHoverSurface}"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassInputFocusSurface}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True"/>
                </MultiDataTrigger.Conditions><Setter TargetName="Surface" Property="Background" Value="{DynamicResource GlassInputActiveSurface}"/></MultiDataTrigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource GlassInputSurface}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GlassControlBorder}"/></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="Settings"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="QuickResultContainer" TargetType="ListBoxItem">
        <Setter Property="Height" Value="{StaticResource QuickRowHeight}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Surface" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
