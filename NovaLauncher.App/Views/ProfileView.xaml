<UserControl x:Class="NovaLauncher.App.Views.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaLauncher.App.Views"
             Loaded="Profile_Loaded" Unloaded="Profile_Unloaded">
    <Grid>
        <Button x:Name="AvatarButton" Style="{StaticResource ProfileAvatarButton}" Click="Avatar_Click"
                ToolTip="{Binding DisplayName}" AutomationProperties.Name="打开个人资料" AutomationProperties.AutomationId="ProfileAvatar">
            <views:AvatarView Width="{StaticResource ProfileSmallAvatarSize}" Height="{StaticResource ProfileSmallAvatarSize}" />
        </Button>
        <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=AvatarButton}" Placement="Top" VerticalOffset="-8"
               IsOpen="{Binding IsProfileFlyoutOpen, Mode=TwoWay}" StaysOpen="True" AllowsTransparency="True"
               Opened="Flyout_Opened">
            <Border Width="{StaticResource ProfileFlyoutWidth}" Padding="16,12" CornerRadius="{StaticResource SurfaceRadius}"
                    Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    PreviewKeyDown="Flyout_KeyDown" KeyboardNavigation.TabNavigation="Cycle" AutomationProperties.Name="个人资料">
                <StackPanel>
                    <views:AvatarView Width="{StaticResource ProfileLargeAvatarSize}" Height="{StaticResource ProfileLargeAvatarSize}"
                                      HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsEditingName}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource HomeSectionTitle}" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                            <Button x:Name="EditNameButton" Command="{Binding BeginEditNameCommand}" Click="EditName_Click" Style="{StaticResource QuietButton}"
                                    Padding="8,6" AutomationProperties.Name="编辑名称" AutomationProperties.AutomationId="EditProfileName">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}" />
                            </Button>
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsEditingName, Converter={StaticResource BooleanVisibility}}">
                            <TextBlock Text="名称" FontSize="{StaticResource SecondaryTextSize}" Margin="0,0,0,6" />
                            <TextBox x:Name="NameEditor" Text="{Binding DraftName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"
                                     Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                     FontFamily="{StaticResource AppFont}" FontSize="{StaticResource ApplicationNameSize}" AutomationProperties.Name="用户名称" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                <Button Content="取消" Command="{Binding CancelEditNameCommand}" Style="{StaticResource QuietButton}" />
                                <Button Content="保存" Command="{Binding SaveNameCommand}" Style="{StaticResource QuietButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="{StaticResource SecondaryTextSize}" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,8" /><Style.Triggers><DataTrigger Binding="{Binding Error}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Content="更换头像" Command="{Binding ChangeAvatarCommand}" Style="{StaticResource ProfileActionButton}" AutomationProperties.Name="更换头像" />
                    <Button Content="恢复默认头像" Command="{Binding ResetAvatarCommand}" Style="{StaticResource ProfileActionButton}"
                            Visibility="{Binding HasCustomAvatar, Converter={StaticResource BooleanVisibility}}" AutomationProperties.Name="恢复默认头像" />
                    <Button Command="{Binding OpenSettingsCommand}" Style="{StaticResource ProfileActionButton}"
                            AutomationProperties.Name="打开设置" AutomationProperties.AutomationId="ProfileSettings">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,10,0" /><TextBlock Text="设置" FontSize="{StaticResource ActionTextSize}" /></StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
