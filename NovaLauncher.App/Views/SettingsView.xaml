<UserControl x:Class="NovaLauncher.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:views="clr-namespace:NovaLauncher.App.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Focusable="False">
  <StackPanel Margin="0,0,12,12">
   <TextBlock Text="设置" Style="{StaticResource SettingsPageTitle}" />
   <views:BackgroundStartupView DataContext="{Binding BackgroundStartup}"><views:BackgroundStartupView.Style><Style TargetType="views:BackgroundStartupView"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:BackgroundStartupView.Style></views:BackgroundStartupView>
   <views:GlobalHotkeyView DataContext="{Binding Hotkey}"><views:GlobalHotkeyView.Style><Style TargetType="views:GlobalHotkeyView"><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></views:GlobalHotkeyView.Style></views:GlobalHotkeyView>
   <TextBlock Text="外观" Style="{StaticResource SettingsSectionTitle}" />
   <Expander x:Name="BackgroundExpander" Header="背景" FocusVisualStyle="{StaticResource FocusRing}" IsExpanded="False" Margin="0,0,0,8" AutomationProperties.Name="背景设置">
    <views:AppearanceView DataContext="{Binding Appearance}"/>
   </Expander>
   <Border Style="{StaticResource SettingsRow}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="主题"/><TextBlock Text="即将支持" Style="{StaticResource SettingsDescription}"/></StackPanel>
    <Button Grid.Column="1" Content="浅色  ›" Style="{StaticResource SettingsButton}" Command="{Binding AppearanceCommand}" AutomationProperties.Name="主题，浅色，即将支持"/>
   </Grid></Border>
   <views:CategoryManagementView DataContext="{Binding DataContext.Content.CategoryManager, RelativeSource={RelativeSource AncestorType=Window}}"/>
   <TextBlock Text="启动与窗口" Style="{StaticResource SettingsSectionTitle}" />
   <Border Style="{StaticResource SettingsRow}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="记住窗口大小"/><TextBlock Text="下次启动时恢复关闭前的大小" Style="{StaticResource SettingsDescription}"/></StackPanel>
    <CheckBox x:Name="RememberSize" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding RememberWindowSize}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="记住窗口大小"/>
   </Grid></Border>
   <Border Style="{StaticResource SettingsRow}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="记住窗口位置"/><TextBlock Text="下次启动时恢复关闭前的位置" Style="{StaticResource SettingsDescription}"/></StackPanel>
    <CheckBox x:Name="RememberPosition" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="{Binding RememberWindowPosition}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="记住窗口位置"/>
   </Grid></Border>
   <Border Style="{StaticResource SettingsRow}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="启动页面"/><TextBlock Text="重新启动后打开的页面" Style="{StaticResource SettingsDescription}"/></StackPanel>
    <ComboBox x:Name="StartupSelector" Style="{StaticResource SettingsSelector}" Grid.Column="1" MinWidth="116" MinHeight="32" VerticalAlignment="Center" ItemsSource="{Binding StartupPages}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding StartupPage}" IsEnabled="{Binding CanEdit}" AutomationProperties.Name="启动页面"/>
   </Grid></Border>
   <TextBlock Text="数据与存储" Style="{StaticResource SettingsSectionTitle}" />
   <Border Style="{StaticResource SettingsRow}"><StackPanel>
    <TextBlock Text="数据目录"/><TextBlock Text="{Binding DataDirectory}" Style="{StaticResource SettingsDescription}"/>
    <Button Content="打开数据目录" HorizontalAlignment="Left" Style="{StaticResource SettingsButton}" Command="{Binding OpenDataDirectoryCommand}" AutomationProperties.Name="打开数据目录" Margin="0,8,0,0"/>
   </StackPanel></Border>
   <Border Style="{StaticResource SettingsRow}"><StackPanel><TextBlock Text="数据库路径"/><TextBlock Text="{Binding DatabasePath}" Style="{StaticResource SettingsDescription}"/></StackPanel></Border>
   <TextBlock Text="关于" Style="{StaticResource SettingsSectionTitle}" />
   <Border Style="{StaticResource SettingsRow}"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Nova Launcher" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Version, StringFormat=版本 {0}}" Style="{StaticResource SettingsDescription}" VerticalAlignment="Center"/>
   </Grid></Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
