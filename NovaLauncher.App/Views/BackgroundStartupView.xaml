<UserControl x:Class="NovaLauncher.App.Views.BackgroundStartupView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel>
  <TextBlock Text="后台与启动" Style="{StaticResource SettingsSectionTitle}"/>
  <Border Style="{StaticResource SettingsRow}"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="开机启动"/><TextBlock Text="登录 Windows 后在后台启动 Nova" Style="{StaticResource SettingsDescription}"/></StackPanel>
   <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" IsEnabled="{Binding CanEdit}" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="开机启动" AutomationProperties.AutomationId="StartWithWindows"/>
  </Grid></Border>
  <Border Style="{StaticResource SettingsRow}"><Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,0,16,0"><TextBlock Text="关闭窗口时驻留后台"/><TextBlock Text="关闭主窗口后继续保持全局快捷键可用" Style="{StaticResource SettingsDescription}"/></StackPanel>
   <CheckBox Grid.Column="1" IsChecked="{Binding CloseToTray}" IsEnabled="{Binding CanEdit}" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="关闭窗口时驻留后台" AutomationProperties.AutomationId="CloseToTray"/>
  </Grid></Border>
  <TextBlock Text="驻留后台时，可通过全局快捷键快速呼出 Nova。右键托盘图标可退出 Nova。" Style="{StaticResource SettingsDescription}"/>
  <TextBlock Text="{Binding Status}" Style="{StaticResource SettingsDescription}" AutomationProperties.LiveSetting="Polite"/>
 </StackPanel>
</UserControl>
