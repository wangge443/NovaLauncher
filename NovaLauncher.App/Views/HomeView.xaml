<UserControl x:Class="NovaLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaLauncher.App.Views">
    <UserControl.Resources>
        <Style x:Key="HomeCards" TargetType="ItemsControl">
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><views:ApplicationCardView /></DataTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="HomeScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" AutomationProperties.Name="首页应用区域">
        <StackPanel Visibility="{Binding HasApplications, Converter={StaticResource BooleanVisibility}}">
            <StackPanel x:Name="RecentSection" Margin="{StaticResource HomeSectionSpacing}"
                        Visibility="{Binding HasRecent, Converter={StaticResource BooleanVisibility}}">
                <Grid Margin="{StaticResource HomeHeadingSpacing}">
                    <TextBlock Text="最近使用" Style="{StaticResource HomeSectionTitle}" />
                    <Button Command="{Binding ShowRecentCommand}" Style="{StaticResource HomeViewAllButton}"
                            AutomationProperties.Name="查看全部最近使用" AutomationProperties.AutomationId="HomeShowRecent" />
                </Grid>
                <ItemsControl x:Name="RecentApplications" ItemsSource="{Binding RecentApplications}" Style="{StaticResource HomeCards}"
                              AutomationProperties.Name="首页最近使用" />
            </StackPanel>
            <StackPanel x:Name="FavoriteSection" Margin="{StaticResource HomeSectionSpacing}"
                        Visibility="{Binding HasFavorites, Converter={StaticResource BooleanVisibility}}">
                <Grid Margin="{StaticResource HomeHeadingSpacing}">
                    <TextBlock Text="收藏" Style="{StaticResource HomeSectionTitle}" />
                    <Button Command="{Binding ShowFavoritesCommand}" Style="{StaticResource HomeViewAllButton}"
                            AutomationProperties.Name="查看全部收藏" AutomationProperties.AutomationId="HomeShowFavorites" />
                </Grid>
                <ItemsControl x:Name="FavoriteApplications" ItemsSource="{Binding FavoriteApplications}" Style="{StaticResource HomeCards}"
                              AutomationProperties.Name="首页收藏" />
            </StackPanel>
            <TextBlock Text="全部应用" Style="{StaticResource HomeSectionTitle}" Margin="{StaticResource HomeHeadingSpacing}" />
            <ItemsControl x:Name="AllApplications" ItemsSource="{Binding AllApplications}" Style="{StaticResource HomeCards}"
                          AutomationProperties.AutomationId="ApplicationGrid" AutomationProperties.Name="全部应用" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
