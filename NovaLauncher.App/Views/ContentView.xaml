<UserControl x:Class="NovaLauncher.App.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaLauncher.App.Views"
             AllowDrop="True" DragEnter="Workspace_DragOver" DragOver="Workspace_DragOver"
             DragLeave="Workspace_DragLeave" Drop="Workspace_Drop">
    <Grid Background="Transparent">
        <Border Margin="8" BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="{StaticResource WorkspacePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Path Data="M 16,0 L 16,32 M 0,16 L 32,16" Stroke="{DynamicResource EmptyIconBrush}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,24" />
            <TextBlock Text="{Binding EmptyTitle}" FontSize="20" TextAlignment="Center"
                       Foreground="{DynamicResource EmptyTextBrush}" AutomationProperties.AutomationId="DropHint" />
            <TextBlock Text="{Binding EmptyHint}" FontSize="12" TextAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False">
            <ItemsControl ItemsSource="{Binding FilteredApplications}" AutomationProperties.AutomationId="ApplicationGrid">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate><views:ApplicationCardView /></DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="4,8,4,0"
                   AutomationProperties.AutomationId="ImportStatus" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>
        <!-- Canvas overlays contribute no desired size and never move the card grid. -->
        <Canvas Margin="{StaticResource WorkspacePadding}" IsHitTestVisible="False" Panel.ZIndex="10">
            <views:ToastView Canvas.Right="0" Canvas.Bottom="0" DataContext="{Binding Toast}"
                             IsOpen="{Binding IsOpen}" />
        </Canvas>
    </Grid>
</UserControl>
