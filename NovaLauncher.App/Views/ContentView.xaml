<UserControl x:Class="NovaLauncher.App.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{StaticResource ContentPadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,28">
            <TextBlock Text="你的启动空间" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="{Binding Sidebar.SelectedItem.Name}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,8"
                       AutomationProperties.AutomationId="ContentTitle" />
            <TextBlock Text="让常用，触手可及。" FontSize="14" Foreground="{DynamicResource MutedTextBrush}" />
        </StackPanel>
        <Border Grid.Row="1" CornerRadius="{StaticResource SurfaceRadius}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource SurfaceBrush}">
            <Grid Margin="24">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="22" Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,24">
                        <Path Data="M 0,0 L 10,0 10,10 0,10 Z M 16,0 L 26,0 26,10 16,10 Z M 0,16 L 10,16 10,26 0,26 Z M 16,16 L 26,16 26,26 16,26 Z"
                              Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Width="28" Height="28" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="为你的热爱，留一个位置" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="游戏、应用与常用收藏，将在这里呈现。" FontSize="13" Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Border CornerRadius="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Padding="12,5" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <TextBlock Text="内容区域 · 待启用" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2" Margin="0,22,0,0">
            <TextBlock Text="简单，有序，随时出发。" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
            <TextBlock Text="NOVA LAUNCHER" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource MutedTextBrush}" />
        </Grid>
    </Grid>
</UserControl>
