<UserControl x:Class="NovaLauncher.App.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Visual placeholder only. File drops are deliberately not enabled. -->
    <Grid Margin="{StaticResource WorkspacePadding}" Background="Transparent">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Path Data="M 16,0 L 16,32 M 0,16 L 32,16" Stroke="{DynamicResource EmptyIconBrush}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="32" Height="32" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,24" />
            <TextBlock Text="请将文件拖拽至此" FontSize="20" TextAlignment="Center"
                       Foreground="{DynamicResource EmptyTextBrush}" AutomationProperties.AutomationId="DropHint" />
            <TextBlock Text="支持 .exe 和 .lnk" FontSize="12" TextAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
