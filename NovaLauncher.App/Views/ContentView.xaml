<UserControl x:Class="NovaLauncher.App.Views.ContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaLauncher.App.Views"
             AllowDrop="True" DragEnter="Workspace_DragOver" DragOver="Workspace_DragOver"
             DragLeave="Workspace_DragLeave" Drop="Workspace_Drop">
    <Grid Background="Transparent">
        <Border Margin="8" BorderThickness="1" CornerRadius="{StaticResource SurfaceRadius}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Background" Value="{DynamicResource SelectedBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid Margin="{StaticResource WorkspacePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers>
                <DataTrigger Binding="{Binding Mode}" Value="Settings"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
            </Style.Triggers></Style></StackPanel.Style>
            <Border Height="{StaticResource SearchHeight}" Width="{StaticResource SearchWidth}" HorizontalAlignment="Left" CornerRadius="{StaticResource SearchRadius}" BorderThickness="1" Background="{DynamicResource WindowBrush}">
                <Border.Style><Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}"/></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </Style.Triggers>
                </Style></Border.Style>
                <Grid Margin="10,0,6,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchBox_KeyDown"
                             BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" VerticalContentAlignment="Center"
                             FontSize="14" Padding="0" AutomationProperties.Name="搜索应用" AutomationProperties.AutomationId="SearchBox"/>
                    <TextBlock Grid.Column="1" Text="搜索应用" IsHitTestVisible="False" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="2" Text="Ctrl + K" Margin="8,0,4,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=SearchBox}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="{StaticResource IconFont}" Width="28" Height="28" Click="ClearSearch_Click" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" AutomationProperties.AutomationId="ClearSearch">
                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasSearchText}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></Button.Style>
                    </Button>
                </Grid>
            </Border>
            <TextBlock Text="{Binding SearchTitle}" HorizontalAlignment="Left" Padding="4,2" Margin="0,12,0,0" Foreground="{DynamicResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SearchLabel}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                    <DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Path Data="M 16,0 L 16,32 M 0,16 L 32,16" Stroke="{DynamicResource EmptyIconBrush}"
                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="{StaticResource EmptyIconSize}" Height="{StaticResource EmptyIconSize}" Stretch="Uniform" HorizontalAlignment="Center" Margin="{StaticResource EmptyIconSpacing}">
                <Path.Style>
                    <Style TargetType="Path">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Favorites"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            <DataTrigger Binding="{Binding Mode}" Value="Recent"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Mode}" Value="Search"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Path.Style>
            </Path>
            <TextBlock Text="&#xE734;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource EmptyIconSize}"
                       Foreground="{DynamicResource EmptyIconBrush}" HorizontalAlignment="Center" Margin="{StaticResource EmptyIconSpacing}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Favorites"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource EmptyIconSize}"
                       Foreground="{DynamicResource EmptyIconBrush}" HorizontalAlignment="Center" Margin="{StaticResource EmptyIconSpacing}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Recent"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource EmptyIconSize}" Foreground="{DynamicResource EmptyIconBrush}" HorizontalAlignment="Center" Margin="{StaticResource EmptyIconSpacing}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSearching}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <TextBlock Style="{StaticResource SearchLabel}" MaxWidth="420" TextWrapping="Wrap" Text="{Binding EmptyTitle}" FontSize="{StaticResource EmptyTitleSize}" TextAlignment="Center"
                       Foreground="{DynamicResource EmptyTextBrush}" AutomationProperties.AutomationId="DropHint" />
            <TextBlock Style="{StaticResource SearchLabel}" MaxWidth="420" TextWrapping="Wrap" Text="{Binding EmptyHint}" FontSize="{StaticResource SecondaryTextSize}" TextAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}" Margin="{StaticResource EmptyHintSpacing}" />
        </StackPanel>
        <ContentControl Grid.Row="1" Focusable="False" Content="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <ContentControl.Style>
                <Style TargetType="ContentControl">
                    <Setter Property="ContentTemplate">
                        <Setter.Value>
                            <DataTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                                    <ItemsControl ItemsSource="{Binding FilteredApplications}" AutomationProperties.AutomationId="ApplicationGrid">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate><views:ApplicationCardView /></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DataTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                <ItemsControl ItemsSource="{Binding FilteredApplications}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.AutomationId="ApplicationGrid">
                                    <ItemsControl.Template><ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsPresenter/>
                                        </ScrollViewer>
                                    </ControlTemplate></ItemsControl.Template>
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><views:SearchWrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate><views:ApplicationCardView/></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate></Setter.Value></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Mode}" Value="Settings">
                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                                <views:SettingsView DataContext="{Binding DataContext.Settings, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </DataTemplate></Setter.Value></Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHomeDashboard}" Value="True">
                            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><views:HomeView DataContext="{Binding Home}" /></DataTemplate></Setter.Value></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ContentControl.Style>
        </ContentControl>
        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Foreground="{DynamicResource MutedTextBrush}" FontSize="{StaticResource SecondaryTextSize}" Margin="4,8,4,0"
                   AutomationProperties.AutomationId="ImportStatus" AutomationProperties.LiveSetting="Polite">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusMessage}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        </Grid>
        <!-- Canvas overlays contribute no desired size and never move the card grid. -->
        <Canvas Margin="{StaticResource WorkspacePadding}" IsHitTestVisible="False" Panel.ZIndex="10">
            <views:ToastView Canvas.Right="0" Canvas.Bottom="0" DataContext="{Binding Toast}"
                             IsOpen="{Binding IsOpen}" />
        </Canvas>
    </Grid>
</UserControl>
