<UserControl x:Class="NovaLauncher.App.Views.ApplicationCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="{StaticResource ApplicationCardWidth}" Height="{StaticResource ApplicationCardHeight}"
             Margin="{StaticResource ApplicationCardMargin}"
             AutomationProperties.Name="{Binding DisplayName}"
             MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave"
             GotKeyboardFocus="Card_FocusChanged" LostKeyboardFocus="Card_FocusChanged"
             Loaded="Card_Loaded" Unloaded="Card_Unloaded" PreviewKeyDown="Card_PreviewKeyDown">
    <UserControl.ContextMenu>
        <ContextMenu x:Name="CardMenu" Style="{StaticResource ManagementContextMenu}"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Opened="CardMenu_Opened" Closed="CardMenu_Closed" AutomationProperties.Name="应用操作">
            <MenuItem x:Name="FavoriteMenuItem" Header="{Binding FavoriteMenuText}" Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="{Binding FavoriteActionName}">
                <MenuItem.Icon><TextBlock Text="{Binding FavoriteGlyph}" Style="{StaticResource ManagementIcon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="MoveCategoryMenuItem" Header="移动到分类" ItemsSource="{Binding CategoryManager.Choices}" IsEnabled="{Binding CategoryManager.IsReady}">
                <MenuItem.Icon><TextBlock Text="&#xE8B7;" Style="{StaticResource ManagementIcon}"/></MenuItem.Icon>
                <MenuItem.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource ManagementMenuItem}">
                    <Setter Property="Header" Value="{Binding Name}"/>
                    <Setter Property="Command" Value="{Binding DataContext.ChangeCategoryCommand, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                    <Setter Property="CommandParameter" Value="{Binding}"/>
                </Style></MenuItem.ItemContainerStyle>
            </MenuItem>
            <Separator Style="{StaticResource ManagementSeparator}"/>
            <MenuItem x:Name="LocationMenuItem" Header="打开文件位置" Command="{Binding OpenLocationCommand}">
                <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource ManagementIcon}"/></MenuItem.Icon>
            </MenuItem>
            <MenuItem x:Name="InfoMenuItem" Header="应用信息" Click="InfoMenu_Click">
                <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource ManagementIcon}"/></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.ToolTip>
        <ToolTip Content="{Binding DisplayName}" />
    </UserControl.ToolTip>
    <Grid Background="Transparent">
        <Grid.RenderTransform><TranslateTransform x:Name="Lift" /></Grid.RenderTransform>
        <Button x:Name="LaunchButton" Command="{Binding LaunchCommand}" Click="LaunchButton_Click"
                AutomationProperties.Name="{Binding DisplayName}" AutomationProperties.AutomationId="LaunchApplication"
                AutomationProperties.HelpText="{Binding LastLaunchText}"
                FocusVisualStyle="{StaticResource FocusRing}" Background="Transparent" BorderThickness="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <ContentPresenter />
                </ControlTemplate>
            </Button.Template>
            <Grid Background="Transparent">
                <Border x:Name="HoverSurface" CornerRadius="{StaticResource ApplicationCardRadius}" Opacity="0">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
                        <Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.HasImage, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource AppearanceLabelSurface}"/>
                        </DataTrigger></Style.Triggers>
                    </Style></Border.Style>
                </Border>
                <Border x:Name="LaunchFlash" Background="{DynamicResource SelectedBrush}"
                        CornerRadius="{StaticResource ApplicationCardRadius}" Opacity="0" />
                <StackPanel x:Name="NormalContent" Margin="{StaticResource ApplicationCardPadding}" IsHitTestVisible="False">
                    <Image Source="{Binding Icon}" Width="{StaticResource ApplicationIconSize}"
                           Height="{StaticResource ApplicationIconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ApplicationNameStyle}"
                               Margin="{StaticResource ApplicationNameSpacing}" AutomationProperties.AutomationId="ApplicationName" />
                </StackPanel>
                <!-- A fixed overlay swaps presentation without changing card/grid measurements. -->
                <StackPanel x:Name="DetailsContent" Margin="{StaticResource ApplicationDetailsPadding}" Opacity="0" IsHitTestVisible="False">
                    <Image Source="{Binding Icon}" Width="{StaticResource ApplicationDetailsIconSize}"
                           Height="{StaticResource ApplicationDetailsIconSize}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource ApplicationNameStyle}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding LastLaunchText}" Style="{StaticResource ApplicationDetailStyle}" Margin="{StaticResource ApplicationStatisticsMargin}" />
                    <TextBlock Text="{Binding LaunchCountText}" Style="{StaticResource ApplicationDetailStyle}" />
                </StackPanel>
            </Grid>
        </Button>
        <Popup x:Name="InfoPopup" PlacementTarget="{Binding ElementName=LaunchButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               Opened="InfoPopup_Opened" Closed="InfoPopup_Closed">
            <Border Style="{StaticResource ManagementSurface}" Width="360" Padding="18" KeyDown="Info_KeyDown">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <Button x:Name="CloseInfoButton" DockPanel.Dock="Right" Content="关闭" HorizontalAlignment="Right" Style="{StaticResource SettingsButton}" Click="CloseInfo_Click" AutomationProperties.Name="关闭应用信息"/>
                            <TextBlock Text="应用信息" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="名称" Style="{StaticResource SettingsDescription}"/><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/>
                        <TextBlock Text="类型" Style="{StaticResource SettingsDescription}" Margin="0,12,0,0"/><TextBlock Text="{Binding SourceTypeText}"/>
                        <TextBlock Text="目标路径" Style="{StaticResource SettingsDescription}" Margin="0,12,0,0"/>
                        <TextBox Text="{Binding TargetPath, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextBrush}" Padding="0" AutomationProperties.Name="目标路径"/>
                        <TextBlock Text="分类" Style="{StaticResource SettingsDescription}" Margin="0,12,0,0"/><TextBlock Text="{Binding CategoryName}" TextWrapping="Wrap"/>
                        <TextBlock Text="收藏状态" Style="{StaticResource SettingsDescription}" Margin="0,12,0,0"/><TextBlock Text="{Binding FavoriteStatus}"/>
                        <TextBlock Text="{Binding LaunchCountText}" Margin="0,12,0,0"/>
                        <TextBlock Text="{Binding LastLaunchText}" Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
