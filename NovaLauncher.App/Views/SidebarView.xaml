<UserControl x:Class="NovaLauncher.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:NovaLauncher.App.Views">
    <UserControl.Resources>
        <DataTemplate x:Key="NavigationTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="{StaticResource NavigationIconSlot}" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{StaticResource NavigationIconSize}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{StaticResource NavigationTextSize}" Margin="{StaticResource NavigationLabelMargin}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="20,24,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="12,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="12"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding DataContext.Settings.Appearance.Background.IsTransparent, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Background" Value="{DynamicResource GlassBrandSurface}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Path Data="M 3,22 L 3,3 L 19,22 L 19,3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                              Width="19" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOVA" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="L A U N C H E R" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding TopSelectedItem, Mode=TwoWay}"
                     AutomationProperties.AutomationId="SidebarNavigation" AutomationProperties.Name="主导航"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource NavigationItemStyle}" ItemTemplate="{StaticResource NavigationTemplate}" />
            <ListBox ItemsSource="{Binding FooterItems}" SelectedItem="{Binding FooterSelectedItem, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="其他导航" ItemContainerStyle="{StaticResource NavigationItemStyle}"
                     ItemTemplate="{StaticResource NavigationTemplate}" />
            </StackPanel>
            </ScrollViewer>
            <views:ProfileView Grid.Row="2" DataContext="{Binding Profile}" HorizontalAlignment="Left" Margin="3,12,0,0" />
        </Grid>
    </Border>
</UserControl>
