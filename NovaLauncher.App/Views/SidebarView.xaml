<UserControl x:Class="NovaLauncher.App.Views.SidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="NavigationTemplate">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="18"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="14" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="20,24,20,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="12,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource SelectedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                        <Path Data="M 3,22 L 3,3 L 19,22 L 19,3" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.5"
                              Width="19" Height="22" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOVA" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="L A U N C H E R" FontSize="9" Foreground="{DynamicResource MutedTextBrush}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="工作空间" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,0" />
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
            <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding TopSelectedItem, Mode=TwoWay}"
                     AutomationProperties.AutomationId="SidebarNavigation" AutomationProperties.Name="主导航"
                     Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ItemContainerStyle="{StaticResource NavigationItemStyle}" ItemTemplate="{StaticResource NavigationTemplate}" />
            <StackPanel DataContext="{Binding CategoryManager}" Margin="0,0,0,12">
                <Button Style="{StaticResource SidebarActionButtonStyle}"
                        IsEnabled="{Binding IsReady}" Command="{Binding BeginCreateCommand}" Click="BeginCategory_Click"
                        AutomationProperties.AutomationId="NewCategory" AutomationProperties.Name="新建分类">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="18"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Grid.Column="1" Text="新建分类" FontSize="14" Margin="10,0,0,0"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Grid>
                </Button>
                <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="8" Padding="10" Margin="8,6,0,0" Visibility="{Binding IsEditing, Converter={StaticResource BooleanVisibility}}">
                    <StackPanel>
                        <TextBlock Text="分类名称" FontSize="12" Margin="0,0,0,6" />
                        <TextBox x:Name="CategoryNameEditor" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                                 KeyDown="CategoryEditor_KeyDown" AutomationProperties.Name="分类名称" AutomationProperties.AutomationId="CategoryNameEditor"
                                 Padding="6" Background="{DynamicResource WindowBrush}" Foreground="{DynamicResource TextBrush}"
                                 BorderBrush="{DynamicResource BorderBrush}" FontFamily="{StaticResource AppFont}" FontSize="13" />
                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="取消" Command="{Binding CancelCreateCommand}" Style="{StaticResource QuietButton}" />
                            <Button Content="创建" Command="{Binding CreateCommand}" Style="{StaticResource QuietButton}" Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
            <ListBox ItemsSource="{Binding FooterItems}" SelectedItem="{Binding FooterSelectedItem, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="其他导航" ItemContainerStyle="{StaticResource NavigationItemStyle}"
                     ItemTemplate="{StaticResource NavigationTemplate}" />
            </StackPanel>
            </ScrollViewer>
            <!-- Reserved for the future user identity area. -->
            <Border Grid.Row="2" Height="48" />
        </Grid>
    </Border>
</UserControl>
