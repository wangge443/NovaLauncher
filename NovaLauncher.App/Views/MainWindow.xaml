<Window x:Class="NovaLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="800" Height="500"
        MinWidth="400" MinHeight="240"
        WindowStartupLocation="CenterScreen">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
        <TextBlock Text="{Binding Title}" FontSize="24" TextAlignment="Center" />
        <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                   FontSize="16" TextAlignment="Center" />
    </StackPanel>
</Window>
