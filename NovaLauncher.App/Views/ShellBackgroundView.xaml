<UserControl x:Class="NovaLauncher.App.Views.ShellBackgroundView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:NovaLauncher.App.Views"
             x:Name="BackgroundHost" IsHitTestVisible="False" Focusable="False"
             AutomationProperties.AutomationId="ShellBackground">
    <Grid>
        <Border x:Name="SolidColorBackground" Background="{DynamicResource BackgroundFallbackBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackdropActive, ElementName=BackgroundHost}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <!-- The legacy Desktop mode remains internal/experimental. Production uses the image pipeline below. -->
        <Border Background="{Binding SolidBackground, ElementName=BackgroundHost}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Mode, ElementName=BackgroundHost}" Value="SolidColor">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource GlassTintBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackdropActive, ElementName=BackgroundHost}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource NativeGlassTintBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
        <Grid x:Name="ImageLayers" DataContext="{Binding Settings.Appearance.Background}" ClipToBounds="True">
            <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding HasImage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                <DataTrigger Binding="{Binding IsHighContrast, ElementName=BackgroundHost}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style></Grid.Style>
            <Image x:Name="WallpaperImage" Source="{Binding Image}" Stretch="{Binding Stretch}" RenderOptions.BitmapScalingMode="LowQuality">
                <Image.Effect><BlurEffect Radius="{Binding BlurRadius}" KernelType="Gaussian" RenderingBias="Performance"/></Image.Effect>
            </Image>
            <Border x:Name="WhiteOverlay" Background="White" Opacity="{Binding OverlayOpacity}"/>
            <Border Height="48" VerticalAlignment="Top" Background="{DynamicResource SidebarBrush}"/>
        </Grid>
    </Grid>
</UserControl>
