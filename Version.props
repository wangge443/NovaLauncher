<Project>
  <PropertyGroup>
    <!-- Single product version source; About, logs and archive names read assembly metadata. -->
    <Version>0.1.0-preview.1</Version>
    <AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match('$(Version)', '^\d+\.\d+\.\d+').Value).0</AssemblyVersion>
    <FileVersion>$(AssemblyVersion)</FileVersion>
  </PropertyGroup>
</Project>
